# ==============================================================================
# Murabha Cloud - Enterprise Configuration
# ==============================================================================

# Application Environment
NODE_ENV=production
PORT=3000
CORS_ORIGIN=http://localhost

# Database Engine Selection ('postgres' | 'oracle')
DATABASE_TYPE=postgres

# PostgreSQL Configuration (Default & Development)
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=Murabha@Cloud2026!
DB_NAME=murabha

# Oracle Database Configuration (When migrating/switched)
ORACLE_HOST=oracle-db.internal
ORACLE_PORT=1521
ORACLE_SERVICE_NAME=FREEPDB1
ORACLE_USER=SYSTEM
ORACLE_PASSWORD=YourOraclePassword!

# Cryptographic & Session Secrets (MUST be altered in production)
JWT_ACCESS_SECRET=your_super_secret_jwt_access_token_at_least_32_bytes_long
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_token_at_least_32_bytes_long
COOKIE_SECRET=your_super_secret_cookie_signing_key_at_least_32_bytes_long
JWT_SECRET=your_super_secret_jwt_for_java_backend_at_least_32_bytes_long
MASTER_MFA_SECRET=your_base32_mfa_master_secret

